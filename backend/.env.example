# Copy to backend/.env and fill in. Never commit backend/.env.

# Oracle (read-only application account)
KT_DB_USER=
KT_DB_PASSWORD=
KT_DB_DSN=host:1521/service

# Single application login (password stored as an Argon2id hash)
KT_APP_USERNAME=
KT_APP_PASSWORD_HASH=

# Session cookie signing key (random, at least 32 characters)
KT_SESSION_SECRET=
# true when served over HTTPS (required in production)
KT_SESSION_HTTPS_ONLY=true

# Allowed browser origins (only needed if the frontend is served from another origin)
KT_CORS_ORIGINS=[]

# Claude API (server side only). Leave empty to disable written summaries.
KT_ANTHROPIC_API_KEY=
KT_AI_MODEL=claude-sonnet-5
KT_AI_DAILY_CALL_LIMIT=200

# Optional tuning
KT_DB_POOL_MAX=4
KT_DB_QUERY_TIMEOUT_MS=30000
KT_DB_ROW_LIMIT=5000
